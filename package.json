{
  "name": "@rackbops/mcp-kit",
  "version": "0.1.0",
  "description": "Shared kit for remote MCP servers: a contract-driven tool registry and dispatcher over the official MCP SDK.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rackbops/rackbops-mcp-kit.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.16.1",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "biome check . && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^26.6.3",
    "ajv": "^8.20.0",
    "typescript": "^7.0.0",
    "vitest": "^5.0.2"
  },
  "peerDependencies": {
    "@modelcontextprotocol/server": ">=2.3.1 <3",
    "ajv": "^8.20.0"
  }
}
